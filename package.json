{
  "name": "brazi-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc && tsc -p tsconfig.web.json && vite build",
    "start": "node dist/server.js",
    "diagnose": "tsx src/diagnose.ts",
    "test": "tsx --test test/*.test.ts",
    "dev:api": "tsx watch src/server.ts",
    "sync": "tsx src/sync-cli.ts",
    "test:e2e": "playwright test",
    "auth:password": "node scripts/password-hash.mjs",
    "sync:prod": "node dist/sync-cli.js",
    "migrate": "tsx src/migrate-cli.ts",
    "migrate:prod": "node dist/migrate-cli.js",
    "import:sqlite": "tsx src/import-sqlite-cli.ts",
    "staging": "tsx src/staging-cli.ts",
    "staging:prod": "node dist/staging-cli.js"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "cookie": "^1.1.1",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.7",
    "lucide-react": "^1.57.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "undici": "^7.30.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "yaml": "^2.9.1"
  }
}
