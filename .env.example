# Obtenha via desenvolvedor Reserva INK. Escopos de leitura:
# store.orders.read, store.products.read, store.refunds.read
RESERVA_INK_TOKEN=
PORT=3000
# URL privada do PostgreSQL / Supabase; nunca use prefixo VITE_.
DATABASE_URL=
DATABASE_POOL_MAX=3
# Opcional: PEM da CA oficial do banco, se exigido pela cadeia TLS.
# DATABASE_CA_CERT=
# Testes: banco PostgreSQL LOCAL separado, nome terminado em _test.
TEST_DATABASE_URL=
BUSINESS_TIMEZONE=America/Sao_Paulo
API_PAUSE_MS=1800
SYNC_MAX_PAGES=1000
DIAGNOSTIC_MAX_PAGES=1000
# Opcional: configure apenas após confirmar moeda/unidade com a INK.
# Sem esta variável, os valores aparecem como unidades monetárias da API.
# DISPLAY_CURRENCY=BRL

# Configuração local. No Render, NODE_ENV=production e autenticação é obrigatória.
NODE_ENV=development
AUTH_ENABLED=false
AUTH_USERNAME=
# Gere com npm run auth:password; não coloque a senha em texto puro.
AUTH_PASSWORD_HASH=
# Opcional no Render: usa RENDER_EXTERNAL_URL quando vazio.
# Para domínio próprio, utilize a origem HTTPS completa, sem caminho.
APP_ORIGIN=

# Somente staging isolado: bloqueia INK mesmo com token presente.
# BRAZI_ENV=staging
# INK_SYNC_DISABLED=true
# STAGING_POLICY_PATH=/caminho/privado/staging-policy.json
# Ver docs/planning/phase-2-e1-staging-g2.md antes de qualquer operação.
